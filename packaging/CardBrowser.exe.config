<?xml version="1.0" encoding="utf-8"?>
<!-- Beside CardBrowser.exe (the spec copies it). .NET Framework refuses DLLs from a downloaded (marked) copy or a network
     folder unless this is on; pythonnet then fails with "Failed to resolve Python.Runtime.Loader.Initialize". -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
